/*=============================================================================
 fma-peak.comp: arithmetic peak probe. Every thread runs CHAINS independent
     FMA chains for `iters` rounds and stores their sum, so nothing is dead.

     mode 0: fp32 FMA, 1: fp16 scalar FMA, 2: fp16 f16vec2 FMA

     FLOPs = threads x iters x CHAINS x 2 (x 2 more for f16vec2)
=============================================================================*/
#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = wgSize (same SpecId)

layout(constant_id = 0) const uint wgSize = 128;
layout(constant_id = 1) const uint mode   = 0;

const uint CHAINS = 16;

layout(set = 0, binding = 0) writeonly buffer O_BUF { float bufferO[]; };

layout(push_constant) uniform PushConstants {
    uint  iters;
    float a;   // |a| < 1 keeps every chain bounded: x -> a x + b
    float b;
};

void main()
{
    const uint gid  = gl_GlobalInvocationID.x;
    const float seed = float(gl_LocalInvocationID.x) * 1e-3;
    float sum = 0.0;

    if (mode == 0u)
    {
        float x[CHAINS];
        [[unroll]] for (uint c = 0; c < CHAINS; c++) x[c] = seed + float(c);
        for (uint i = 0; i < iters; i++)
            [[unroll]] for (uint c = 0; c < CHAINS; c++) x[c] = fma(x[c], a, b);
        [[unroll]] for (uint c = 0; c < CHAINS; c++) sum += x[c];
    }
    else if (mode == 1u)
    {
        const float16_t ah = float16_t(a), bh = float16_t(b);
        float16_t x[CHAINS];
        [[unroll]] for (uint c = 0; c < CHAINS; c++) x[c] = float16_t(seed + float(c));
        for (uint i = 0; i < iters; i++)
            [[unroll]] for (uint c = 0; c < CHAINS; c++) x[c] = fma(x[c], ah, bh);
        [[unroll]] for (uint c = 0; c < CHAINS; c++) sum += float(x[c]);
    }
    else
    {
        const f16vec2 ah = f16vec2(float16_t(a)), bh = f16vec2(float16_t(b));
        f16vec2 x[CHAINS];
        [[unroll]] for (uint c = 0; c < CHAINS; c++) x[c] = f16vec2(float16_t(seed + float(c)), float16_t(seed - float(c)));
        for (uint i = 0; i < iters; i++)
            [[unroll]] for (uint c = 0; c < CHAINS; c++) x[c] = fma(x[c], ah, bh);
        [[unroll]] for (uint c = 0; c < CHAINS; c++) sum += float(x[c].x) + float(x[c].y);
    }

    bufferO[gid] = sum;
}
