/*=============================================================================
 vec32.comp: vec.comp with 32 B per thread per k pair: thread t reads chunks
     2c and 2c + 1 (c = t % 4), the 8 columns of lanes 4c .. 4c + 3

     O[n] = sum_k I[k] * W[n, k]

     O [N] (or split-K partials P[z, N]) and I [K] are fp32 or fp16, W fp16 or
     fp32, via same-binding buffer aliases; accumulation is fp32.

 Packed W: 32-column blocks, each a contiguous run of K pairs x 64 values,
 W'[n / 32, k / 2, n % 16, (k % 2) * 2 + (n % 32) / 16]. A workgroup of WG
 threads owns one block (and one K span under split-K) and reads it in 16 B
 chunks, 8 values each, contiguous across the workgroup. Chunk c of a k pair
 always holds columns 2c, 2c + 16, 2c + 1 and 2c + 17 (lanes 2c and 2c + 1 of
 linear-tile-intel), so thread t keeps chunk c = t % 8 and sums those four
 columns over the k pairs r, r + WG / 8, ... (r = t / 8). The threads sharing a
 chunk then fold: lanes l and l ^ 8 by a shuffle, the subgroups through
 shared memory.

 Dispatch (host): (ceil(N / 32), 1, splits); splitSize even.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "common/spec_constants.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = WG (same SpecId)

layout(constant_id = 0) const uint WG = 128;   // threads per workgroup: 128 .. 1024, a power of 2

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // I (input) dtype
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 1;  // W (weight) dtype

const uint ROWS   = WG / 4u;     // k pairs a workgroup reads per step
const uint SG     = 16u;         // subgroup size (pinned on the pipeline)
const uint NSG    = WG / SG;    // up to 64

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_2F32 { vec2 bufferI_2f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_2F16 { uint bufferI_2f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) readonly buffer W_BUF_8F16 { uvec4 bufferW_8f16[]; };
layout(set = 0, binding = 2) readonly buffer W_BUF_4F32 { vec4 bufferW_4f32[]; };

layout(push_constant) uniform PushConstants {
    uint M;           // 1
    uint N;
    uint K;
    uint splitSize;   // K span per workgroup z (= K without splitting), even
};

float readI(uint k) { return (k >= K) ? 0.0 : (typeI == DTYPE_F32) ? bufferI_f32[k] : float(bufferI_f16[k]); }

// I[2p], I[2p + 1]: one 8 B (fp32) / 4 B (fp16) load when the pair is whole and K even.
vec2 readI2(uint p)
{
    if (K % 2u == 0u)
        return (typeI == DTYPE_F32) ? bufferI_2f32[p] : vec2(unpackFloat2x16(bufferI_2f16[p]));
    return vec2(readI(2u * p), readI(2u * p + 1u));
}
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

shared vec4 sSum[NSG][8];   // [subgroup][chunk]

// Chunk q (8 values) of the packed W, then the four columns' share of k pair (x0, x1).
vec4 chunkDot(uint q, float x0, float x1)
{
    vec4 e0, e1;   // values 0..3 and 4..7: [k0 g0, k0 g1, k1 g0, k1 g1] of lanes 2c and 2c + 1
    if (typeW == DTYPE_F16)
    {
        const uvec4 u = bufferW_8f16[q];
        e0 = vec4(vec2(unpackFloat2x16(u.x)), vec2(unpackFloat2x16(u.y)));
        e1 = vec4(vec2(unpackFloat2x16(u.z)), vec2(unpackFloat2x16(u.w)));
    }
    else
    {
        e0 = bufferW_4f32[2u * q];
        e1 = bufferW_4f32[2u * q + 1u];
    }
    // columns 2c, 2c + 16, 2c + 1, 2c + 17
    return vec4(e0.x * x0 + e0.z * x1, e0.y * x0 + e0.w * x1, e1.x * x0 + e1.z * x1, e1.y * x0 + e1.w * x1);
}

void main()
{
    const uint t = gl_LocalInvocationID.x, c = t % 4u, r = t / 4u;
    const uint blk = gl_WorkGroupID.x, z = gl_WorkGroupID.z;
    const uint kPairs = (K + 1u) / 2u;
    const uint p0 = z * (splitSize / 2u), p1 = min(kPairs, p0 + splitSize / 2u);
    const uint base = blk * kPairs * 8u + 2u * c;   // chunk index of (k pair 0, chunk 2c) in the block

    vec4 acc = vec4(0.0), acc2 = vec4(0.0);
    uint p = p0 + r;
    for (; p + 3u * ROWS < p1; p += 4u * ROWS)
    {
        [[unroll]] for (uint u = 0; u < 4u; u++)
        {
            const uint pp = p + u * ROWS;
            const vec2 x = readI2(pp);
            acc  += chunkDot(base + pp * 8u, x.x, x.y);
            acc2 += chunkDot(base + pp * 8u + 1u, x.x, x.y);
        }
    }
    for (; p < p1; p += ROWS)
    {
        const vec2 x = readI2(p);
        acc  += chunkDot(base + p * 8u, x.x, x.y);
        acc2 += chunkDot(base + p * 8u + 1u, x.x, x.y);
    }

    // Fold the threads sharing chunks 2c, 2c + 1: lanes l, l ^ 4, l ^ 8, l ^ 12, then the subgroups.
    acc  += subgroupShuffleXor(acc, 4u);  acc  += subgroupShuffleXor(acc, 8u);
    acc2 += subgroupShuffleXor(acc2, 4u); acc2 += subgroupShuffleXor(acc2, 8u);
    const uint lane = gl_SubgroupInvocationID, sg = gl_SubgroupID;
    if (lane < 4u) { sSum[sg][2u * lane] = acc; sSum[sg][2u * lane + 1u] = acc2; }
    barrier();

    if (t < 32u)
    {
        const uint cc = t / 4u, j = t % 4u;
        float s = 0.0;
        [[unroll]] for (uint g = 0; g < NSG; g++) s += sSum[g][cc][j];
        const uint col = 2u * cc + ((j == 1u || j == 3u) ? 16u : 0u) + ((j >= 2u) ? 1u : 0u);
        const uint n = blk * 32u + col;
        if (n < N) writeO(z * N + n, s);
    }
}
